[Unit]
Description=qregistry admin UI
Documentation=https://github.com/glennswest/qregistry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/qregistry --config /etc/qregistry/qregistry.toml
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
