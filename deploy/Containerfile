# qregistry appliance container image (no stormd; Fedora base).
#
# Runs the two tiered registries + the admin UI via a small entrypoint.
# The full systemd-supervised experience is the Proxmox LXC; this image is
# the portable container flavor.
#
# Expects the three static binaries staged in dist/<arch>/ by CI:
#   qregistry  rspace-registry  rspacefs-mount
#
# Build (from repo root):
#   podman build --build-arg ARCH=x86_64 -f deploy/Containerfile \
#       -t forcicd.g8.lo:5000/qregistry:latest .

FROM registry.fedoraproject.org/fedora-minimal:43

ARG ARCH=x86_64

RUN microdnf install -y fuse fuse3 && microdnf clean all

COPY dist/${ARCH}/qregistry       /usr/local/bin/qregistry
COPY dist/${ARCH}/rspace-registry /usr/local/bin/rspace-registry
COPY dist/${ARCH}/rspacefs-mount  /usr/local/bin/rspacefs-mount

COPY config/qregistry.toml   /etc/qregistry/qregistry.toml
COPY deploy/entrypoint.sh    /usr/local/bin/entrypoint.sh

EXPOSE 5000 5001 8081
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
